<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 260725Cl 削除: <AssemblyVersion>/<FileVersion> の静的値 (旧値 2026.7.23.1630)。
         VS 拡張 Automatic Versions がビルド毎に書き換えるだけの行で、出荷物には一切使われていなかった:
         ① release.yml / build-arm64-portable.yml / validate-wix-msi.yml の全 managed publish が
            -p:AssemblyVersion=<UTCタイムスタンプ> -p:FileVersion=<同> を注入し、この値を必ず上書きする
            (ProjectReference にも伝播することを実測確認: 4 アセンブリすべてが注入値になる)
         ② AssemblyVersion / FileVersion を読む C# コードは存在しない (バージョン表示・更新チェックは
            Version.cs の History 由来。ProgramUpdates は GitHub の Version.cs を raw 取得して比較)
         ③ WiX が使うのは Version.cs 由来の ProductVersion のみ
         ⚠CI 側の FileVersion 注入は廃止不可 — 欠くと MSI のファイルバージョン規則で自前アセンブリの
           FileCopy が costing 段階で省略され、アップグレード時にファイルが欠落する (release.yml の実証記録)。
         この行が復活していたら Automatic Versions が再インストールされている。 -->
    <!-- <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion> --><!-- 260405Cl .NET 10はWindows7非対応のため削除 -->
    <Platforms>x64</Platforms>
    <PublishReadyToRun>true</PublishReadyToRun>
    <OptimizationPreference>Speed</OptimizationPreference>
    <!--
    <TieredCompilation>false</TieredCompilation>
    <TieredCompilationQuickJit>false</TieredCompilationQuickJit>
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
    -->
    <!-- (260402Ch) 起動後の実行性能を重視して tiered compilation と dynamic PGO を有効化し、QuickJit 系は既定値へ戻す -->
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="OpenTK.dll.config" />
  </ItemGroup>

  <!-- 260604Cl: NIST elastic PCHIP データ。旧 96 個の生成 .cs (ushort[][]/float[][] コレクション式) を
       Brotli 圧縮バイナリリソースへ集約。実行時は NistElasticPchipResource が元素単位で展開 (ビット完全等価)。 -->
  <ItemGroup>
    <EmbeddedResource Include="Atom\NistElastic\NistElasticPchip.bin">
      <LogicalName>Crystallography.NistElasticPchip.bin</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 260818Cl: Temari 原子散乱因子 f_x / f_e (dataset-factors v1.0.0, CC-BY-4.0)。全 7681 節点を絶対量子化して
       Brotli 圧縮 (ReciPro 固有の格納形式。Temari データセットの仕様ではない)。生成は
       tools/TemariFactorsGen/pack_temari_factors.py、展開は AtomStatic.TemariScattering が元素単位 lazy。 -->
  <ItemGroup>
    <EmbeddedResource Include="Atom\TemariFactors.bin">
      <LogicalName>Crystallography.TemariFactors.bin</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 260801Cl: STEM-EDX イオン化データ。F(s,E0) 本番テーブル (dataset 1.0.0, 127ch, 完全自前 DHFS 計算) と
       Bote-Salvat 断面積係数 (Z=1-99, NIST public domain 系)。生成は tools/IonizationGen/pack_resource.py、
       契約は同 prod/MANIFEST.md。実行時は IonizationFsTable / BoteSalvat がチャネル/一括 lazy 展開。 -->
  <ItemGroup>
    <EmbeddedResource Include="Diffraction\Ionization\IonizationFsE0.bin">
      <LogicalName>Crystallography.IonizationFsE0.bin</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Diffraction\Ionization\BoteSalvat.bin">
      <LogicalName>Crystallography.BoteSalvat.bin</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 260604Cl: SymmetryStatic の大きなテーブル(整数ジャグ配列 + StrArray 文字列表)を可読 .csv へ移し EmbeddedResource 化
       (旧: C# コレクション式リテラル)。ソースは人間可読・Excel で開ける・編集可・git diff 容易。
       実行時は SymmetryStatic の Load*Jagged2/3 が同一の公開型へ構築 (RFC4180 CSV パーサ)。 -->
  <ItemGroup>
    <EmbeddedResource Include="Symmetry\PositionsDictionary.csv">
      <LogicalName>Crystallography.PositionsDictionary.csv</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Symmetry\OperationDictionary.csv">
      <LogicalName>Crystallography.OperationDictionary.csv</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Symmetry\SiteSymmetryDictionary.csv">
      <LogicalName>Crystallography.SiteSymmetryDictionary.csv</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Symmetry\BelongingNumberOfSymmetry.csv">
      <LogicalName>Crystallography.BelongingNumberOfSymmetry.csv</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Symmetry\NumArray.csv">
      <LogicalName>Crystallography.NumArray.csv</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Symmetry\StrArray.csv">
      <LogicalName>Crystallography.StrArray.csv</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Symmetry\PositionStringList.csv">
      <LogicalName>Crystallography.PositionStringList.csv</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="6.0.0-beta2" />
    <PackageReference Include="MemoryPack" Version="1.21.4" />
    <!--<PackageReference Include="NativeMemoryArray" Version="1.2.2" />--><!-- 260407Cl 未使用のため削除 -->
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="PureHDF" Version="2.2.0" />
    <PackageReference Include="SimdLinq" Version="1.3.2" />
    <PackageReference Include="DynamicExpresso.Core" Version="2.19.5" /><!-- 260427Cl System.Linq.Dynamic.Core から置換 (用途: 対称操作式パース) -->
    <PackageReference Include="ZLinq" Version="1.5.6" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="SimdLinq" />
  </ItemGroup>

</Project>
