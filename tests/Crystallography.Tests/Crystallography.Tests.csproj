<Project Sdk="Microsoft.NET.Sdk">

  <!-- 261105Cl 新規: Crystallography の回帰テスト (xUnit)。
       基準データ Reference/symmetry_reference.json は spglib / cctbx から generate_symmetry_reference.py で生成したもの。
       実行: dotnet test tests/Crystallography.Tests -c Release   (Linux では -p:EnableWindowsTargeting=true を追加)
       Linux でも実行できる (WinForms に触れる経路はテストしない)。Linux では EnableWindowsTargeting で
       net10.0-windows をビルドし、WindowsDesktop ランタイムへの推移参照を外して Microsoft.NETCore.App だけで起動する。 -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- 本体の [SupportedOSPlatform("windows")] 由来の CA1416 はテストでは無意味なので抑止 -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linux では参照先 (net10.0-windows) のビルドにも EnableWindowsTargeting が要るため、
         dotnet test に -p:EnableWindowsTargeting=true を付けて実行する (README.md 参照) -->
    <ProjectReference Include="..\..\Crystallography.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Reference\symmetry_reference.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
